      "link": null,
      "locked": false,
      "text": "Dependency Inversion\nthis is where your architecture starts becoming truly scalable and \nmaintainable.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dependency Inversion\nthis is where your architecture starts becoming truly scalable and \nmaintainable.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "YbgoOD24GHBzxXhNs6hla",
      "type": "text",
      "x": 334.1897162614657,
      "y": 2128.6867495030547,
      "width": 611.0396728515625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 46639128,
      "version": 168,
      "versionNonce": 301337192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788360266287,
      "link": null,
      "locked": false,
      "text": "What is Dependency Inversion?\nHigh level business logic should not depend directly on low level\nimplementation details.both should depend on abstractions.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is Dependency Inversion?\nHigh level business logic should not depend directly on low level\nimplementation details.both should depend on abstractions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
